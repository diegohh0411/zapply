# Copy to .env for `make run`. Development values only.
ZAPPLY_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://zapply_app:zapply_app@127.0.0.1:54329/zapply?sslmode=disable
MIGRATE_DATABASE_URL=postgres://zapply:zapply@127.0.0.1:54329/zapply?sslmode=disable
RELAY_DATABASE_URL=postgres://zapply_relay:zapply_relay@127.0.0.1:54329/zapply?sslmode=disable
WORKER_DATABASE_URL=postgres://zapply_worker:zapply_worker@127.0.0.1:54329/zapply?sslmode=disable
WORKER_ADMIN_ADDR=127.0.0.1:8082
WORKER_CONCURRENCY=4
# Explicit OpenRouter model and endpoint; no paid requests until configured.
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_ENDPOINT=openai
# Generate a 32-byte base64 encryption key outside this file. Keep old versions
# while stored credentials reference them. Use the same ring on API and worker.
# SYSTEM_KEY_RING='{"v1":"<base64-encoded-32-byte-key>"}'
# SYSTEM_KEY_ACTIVE_VERSION=v1
# Optional: export traces only when an OTLP endpoint is explicitly configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NATS_URL=nats://127.0.0.1:4222
RELAY_ADMIN_ADDR=127.0.0.1:8081
# Optional: EVENT_RETENTION=24h RELAY_INTERVAL=200ms RELAY_BATCH=500
#           SSE_BUFFER=256 SSE_MAX_STREAMS_PER_USER=8
# At least 32 bytes. Enables `zapply devtoken`. Never set in production.
AUTH_DEV_SECRET=change-me-dev-secret-at-least-32-bytes
# Web app sign-in (served to the browser as /config.json; both values are public)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<publishable anon key>
# Production: an OIDC provider's JWKS, e.g. Supabase
# AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_ISSUER=https://<project>.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
