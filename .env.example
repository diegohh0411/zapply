# Copy to .env for `make run`. Development values only.
ZAPPLY_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://zapply_app:zapply_app@127.0.0.1:54329/zapply?sslmode=disable
MIGRATE_DATABASE_URL=postgres://zapply:zapply@127.0.0.1:54329/zapply?sslmode=disable
RELAY_DATABASE_URL=postgres://zapply_relay:zapply_relay@127.0.0.1:54329/zapply?sslmode=disable
WORKER_DATABASE_URL=postgres://zapply_worker:zapply_worker@127.0.0.1:54329/zapply?sslmode=disable
WORKER_ADMIN_ADDR=127.0.0.1:8082
WORKER_CONCURRENCY=10
# Explicit OpenRouter model and endpoint; no paid requests until configured.
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_ENDPOINT=openai
# Generate a 32-byte base64 encryption key outside this file. Keep old versions
# while stored credentials reference them. Use the same ring on API and worker.
# SYSTEM_KEY_RING='{"v1":"<base64-encoded-32-byte-key>"}'
# SYSTEM_KEY_ACTIVE_VERSION=v1
# Optional: export traces only when an OTLP endpoint is explicitly configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NATS_URL=nats://127.0.0.1:4222
RELAY_ADMIN_ADDR=127.0.0.1:8081
# Optional: EVENT_RETENTION=24h RELAY_INTERVAL=200ms RELAY_BATCH=500
#           SSE_BUFFER=256 SSE_MAX_STREAMS_PER_USER=8
# At least 32 bytes. Enables `zapply devtoken`. Never set in production.
AUTH_DEV_SECRET=change-me-dev-secret-at-least-32-bytes
# Web app sign-in (served to the browser as /config.json; both values are public)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<publishable anon key>
# Production: an OIDC provider's JWKS, e.g. Supabase
# AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_ISSUER=https://<project>.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
# Posting links in the new job dialog are read by a scraper. SCRAPER_PROVIDER is
# firecrawl or none; unset, it is firecrawl whenever a FIRECRAWL_* value is set.
# Production: Firecrawl's API, with only FIRECRAWL_API_KEY=fc-... (no URL).
# Development: Firecrawl Local (`make firecrawl`) at FIRECRAWL_URL with its token.
# SCRAPER_PROVIDER=firecrawl
# FIRECRAWL_API_KEY=fc-...
FIRECRAWL_URL=http://127.0.0.1:3002
FIRECRAWL_TOKEN=change-me-dev-firecrawl-token
# off (default): pages load only from this machine. auto: pages that block it
# go through Firecrawl Cloud, which then sees their URLs.
# FIRECRAWL_CLOUD=auto
# Server-side CV compiles (GET /v1/cv-exports/{id}/pdf): a Typst CLI per pinned
# version at $TYPST_DIR/<version>/typst. Unset uses typst on PATH if its version
# matches. Browsers compile CVs themselves and don't need it.
# TYPST_DIR=/typst
# Gmail inbox (part 10). All optional; docs/parts/10-mail-plan.md has the setup.
# Register <PUBLIC_URL>/oauth/google/callback on the OAuth client.
# GOOGLE_OAUTH_CLIENT_ID=<client id>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=<client secret>
# PUBLIC_URL=http://localhost:8080
# Push (needs a public URL): topic Gmail publishes to, and the push subscription's
# service account, whose signed token the endpoint requires.
# GOOGLE_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# GOOGLE_PUBSUB_SERVICE_ACCOUNT=<name>@<project>.iam.gserviceaccount.com
# GOOGLE_PUBSUB_AUDIENCE=<defaults to PUBLIC_URL/hooks/google/pubsub>
# Without push, each mailbox is read at least this often (default 6h).
# MAIL_RECONCILE_INTERVAL=30s
