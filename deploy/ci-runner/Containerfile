# A self-hosted GitHub Actions runner for zapply's CI (label `zapply`).
# Built and started by scripts/ci-runner.sh; see deploy/ci-runner/README.md.
FROM ghcr.io/actions/actions-runner:2.338.2

USER root
# Jobs run without sudo, so everything they need is installed here:
# poppler (pdftoppm) and Typst for the render gate, psql, and a C toolchain for -race.
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends poppler-utils postgresql-client build-essential xz-utils jq \
    && rm -rf /var/lib/apt/lists/*

# Keep in step with the typst field of templates/*/*/manifest.json.
ARG TYPST_VERSION=0.14.2
ARG TARGETARCH
RUN case "$TARGETARCH" in arm64) a=aarch64 ;; *) a=x86_64 ;; esac \
    && curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-${a}-unknown-linux-musl.tar.xz" \
      | tar -xJ -C /tmp \
    && install -m 755 "/tmp/typst-${a}-unknown-linux-musl/typst" /usr/local/bin/typst \
    && rm -rf /tmp/typst-*

# Jobs run as `runner` without sudo or docker, so a job can't read the PAT the
# entrypoint (root) holds to register runners.
RUN gpasswd -d runner sudo && gpasswd -d runner docker \
    && mkdir -p /cache && chown runner:runner /cache

COPY entrypoint.sh /usr/local/bin/zapply-runner-entrypoint
RUN chmod 755 /usr/local/bin/zapply-runner-entrypoint

# Dependency and build caches live in the shared volume.
ENV GOMODCACHE=/cache/go/mod \
    GOCACHE=/cache/go/build \
    NPM_CONFIG_CACHE=/cache/npm \
    XDG_CACHE_HOME=/cache/xdg \
    RUNNER_TOOL_CACHE=/cache/toolcache \
    ZAPPLY_TYPST=/usr/local/bin/typst

ENTRYPOINT ["/usr/local/bin/zapply-runner-entrypoint"]
