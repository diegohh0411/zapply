# Development only: the app against local Supabase (`make supa-up`).
# Copy to .env.supabase and run `make run-all ENV_FILE=.env.supabase`.
ZAPPLY_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://zapply_app:zapply_app@127.0.0.1:54322/postgres?sslmode=disable
MIGRATE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
RELAY_DATABASE_URL=postgres://zapply_relay:zapply_relay@127.0.0.1:54322/postgres?sslmode=disable
WORKER_DATABASE_URL=postgres://zapply_worker:zapply_worker@127.0.0.1:54322/postgres?sslmode=disable
# Sign-in through local Supabase Auth. Email links land in Mailpit:
# http://127.0.0.1:54324. The key is the "Publishable" one `make supa-up` prints.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<publishable key from make supa-up>
AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
# Restored data: use the same key ring as the hosted app, or stored credentials
# (model keys, Gmail tokens) can't be decrypted.
# SYSTEM_KEY_RING='{"v1":"<same as .env>"}'
# SYSTEM_KEY_ACTIVE_VERSION=v1
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_ENDPOINT=openai
# FIRECRAWL_URL=http://127.0.0.1:3002
# FIRECRAWL_TOKEN=<same as .env>
